# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication. Required for private user workspaces.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# MongoDB Atlas. Required for user-owned application data.
MONGODB_URI=

# Anthropic Claude. Required for production AI extraction, assistant, insights, and complaint drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Private AWS S3 evidence storage. Required for evidence uploads.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenRouteService Directions API. If unavailable, route safety uses deterministic guidance only.
OPENROUTESERVICE_API_KEY=

# Legacy/display-only Google Maps key, if the UI is extended with map rendering.
# Active route scoring uses OpenRouteService through server routes.
GOOGLE_MAPS_API_KEY=

# Web Push VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@gigshield.local

# First-admin bootstrap. Prefer assigning publicMetadata.role=admin in Clerk after bootstrap.
BOOTSTRAP_ADMIN_CLERK_USER_ID=
BOOTSTRAP_ADMIN_EMAIL=
