# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Clerk authentication. When absent, GigShield runs with a demo server user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB Atlas. When absent, seeded demo data is used.
MONGODB_URI=

# Anthropic Claude. When absent, realistic seeded AI responses are used.
ANTHROPIC_API_KEY=

# Private AWS S3 evidence storage. When absent, upload APIs return demo object keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps Routes API. When absent, seeded Bengaluru route alternatives are used.
GOOGLE_MAPS_API_KEY=

# Web Push VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@gigshield.local
